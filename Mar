<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vertech TdF — Economía Azul</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/tabler-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --void:#02060d;--deep:#050d1a;--panel:#071220;--card:#0a1828;
      --border:#0d2440;--border-hi:#1a3d6b;
      --blue:#2196f3;--blue-dim:rgba(33,150,243,.08);--blue-glow:rgba(33,150,243,.3);
      --cyan:#00d4ff;--cyan-dim:rgba(0,212,255,.08);
      --green:#00e5a0;--green-dim:rgba(0,229,160,.08);
      --amber:#ffb300;--amber-dim:rgba(255,179,0,.08);
      --red:#ff3d3d;--red-dim:rgba(255,61,61,.08);
      --text:#8eb4d4;--text-hi:#c8e0f4;--white:#e8f4ff;
      --mono:'Share Tech Mono',monospace;--sans:'Inter',system-ui,sans-serif;
    }
    body{font-family:var(--sans);background:var(--void);color:var(--text);font-size:12px;line-height:1.4;min-height:100vh;display:flex;flex-direction:column;overflow-x:hidden}
    body::before{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(33,150,243,.01) 2px,rgba(33,150,243,.01) 4px);pointer-events:none;z-index:0}

    header{background:var(--deep);border-bottom:1px solid var(--border);padding:.6rem 1.5rem;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;flex-shrink:0}
    .hdr-left{display:flex;align-items:center;gap:16px}
    .hdr-brand{display:flex;flex-direction:column;line-height:1.1}
    .brand-name{font-family:var(--mono);font-size:14px;color:var(--white);letter-spacing:.12em}
    .brand-name span{color:var(--cyan)}
    .brand-sub{font-size:9px;color:var(--text);letter-spacing:.18em;text-transform:uppercase;margin-top:2px}
    .hdr-nav{display:flex;gap:2px}
    .nav-link{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--text);text-decoration:none;padding:5px 14px;border-radius:3px;border:1px solid transparent;transition:all .15s;text-transform:uppercase}
    .nav-link:hover{color:var(--white);border-color:var(--border-hi)}
    .nav-link.active{color:var(--cyan);border-color:var(--cyan);background:var(--cyan-dim)}
    .hdr-right{display:flex;align-items:center;gap:12px}
    .hdr-status{display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10px;color:var(--cyan);letter-spacing:.08em}
    .status-dot{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 8px var(--blue-glow);animation:blink 2s ease-in-out infinite}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
    .hdr-flag{height:30px;border-radius:3px;border:1px solid var(--border-hi)}

    .main{flex:1;padding:1rem 1.5rem;display:flex;flex-direction:column;gap:10px;position:relative;z-index:1}

    .upload-bar{background:var(--panel);border:1px solid var(--border);border-radius:4px;padding:.75rem 1rem;display:grid;grid-template-columns:1fr 1fr auto auto;gap:10px;align-items:end}
    .field{display:flex;flex-direction:column;gap:4px}
    .field-lbl{font-family:var(--mono);font-size:9px;color:var(--text);letter-spacing:.12em;text-transform:uppercase}
    .field-input{background:var(--card);border:1px solid var(--border);border-radius:3px;padding:6px 10px;font-size:11px;font-family:var(--mono);color:var(--white);outline:none;transition:border-color .2s;letter-spacing:.04em}
    .field-input:focus{border-color:var(--cyan)}
    .field-input::placeholder{color:var(--border-hi)}
    .upload-btn{background:var(--card);border:1px dashed var(--border-hi);border-radius:3px;padding:6px 14px;font-family:var(--mono);font-size:10px;color:var(--cyan);cursor:pointer;position:relative;transition:all .15s;letter-spacing:.08em;white-space:nowrap;display:flex;align-items:center;gap:6px;height:29px}
    .upload-btn:hover{border-color:var(--cyan);background:var(--cyan-dim)}
    .upload-btn input{position:absolute;inset:0;opacity:0;cursor:pointer}
    .run-btn{background:var(--cyan);border:none;border-radius:3px;padding:6px 18px;font-family:var(--mono);font-size:10px;font-weight:600;color:var(--void);cursor:pointer;display:flex;align-items:center;gap:6px;letter-spacing:.1em;transition:all .15s;white-space:nowrap;height:29px}
    .run-btn:hover{box-shadow:0 0 16px var(--blue-glow)}
    .run-btn:disabled{background:var(--border);color:var(--text);cursor:not-allowed;box-shadow:none}

    .preview-strip{display:none;align-items:center;gap:10px;padding:6px 10px;background:var(--panel);border:1px solid var(--border);border-radius:3px}
    .preview-strip.visible{display:flex}
    .preview-strip img{height:36px;width:54px;object-fit:cover;border-radius:2px;border:1px solid var(--border-hi)}
    .preview-fname{font-family:var(--mono);font-size:10px;color:var(--text-hi);flex:1}
    .btn-swap{font-family:var(--mono);font-size:9px;color:var(--text);background:none;border:1px solid var(--border);border-radius:3px;padding:3px 8px;cursor:pointer;letter-spacing:.06em}
    .btn-swap:hover{border-color:var(--border-hi);color:var(--text-hi)}

    .proc-bar{display:none;align-items:center;gap:10px;padding:8px 12px;background:var(--cyan-dim);border:1px solid rgba(0,212,255,.2);border-radius:3px;font-family:var(--mono);font-size:10px;color:var(--cyan);letter-spacing:.06em}
    .proc-bar.visible{display:flex}
    .proc-spin{width:12px;height:12px;border:2px solid rgba(0,212,255,.2);border-top-color:var(--cyan);border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0}
    @keyframes spin{to{transform:rotate(360deg)}}

    .section-eyebrow{font-family:var(--mono);font-size:9px;color:var(--text);letter-spacing:.2em;text-transform:uppercase;display:flex;align-items:center;gap:10px;padding:2px 0}
    .section-eyebrow::after{content:'';flex:1;height:1px;background:var(--border)}

    .metrics-row{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
    .met{background:var(--panel);border:1px solid var(--border);border-radius:4px;padding:10px 12px;position:relative;overflow:hidden}
    .met::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--cyan);opacity:.4}
    .met.accent-red::before{background:var(--red)}
    .met.accent-amber::before{background:var(--amber)}
    .met.accent-blue::before{background:var(--blue)}
    .met-lbl{font-family:var(--mono);font-size:8px;color:var(--text);letter-spacing:.12em;text-transform:uppercase;margin-bottom:4px}
    .met-val{font-family:var(--mono);font-size:22px;font-weight:400;color:var(--cyan);line-height:1;margin-bottom:3px}
    .met-val.red{color:var(--red)}
    .met-val.amber{color:var(--amber)}
    .met-val.blue{color:var(--blue)}
    .met-val.green{color:var(--green)}
    .met-val.white{color:var(--white)}
    .met-sub{font-size:9px;color:var(--text);line-height:1.3}

    .center-grid{display:grid;grid-template-columns:1fr 220px 260px;gap:8px}

    .img-panel{background:var(--card);border:1px solid var(--border);border-radius:4px;overflow:hidden;position:relative}
    .img-panel-hdr{padding:6px 10px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:rgba(0,0,0,.3)}
    .img-panel-title{font-family:var(--mono);font-size:10px;color:var(--text-hi);letter-spacing:.08em}
    .img-panel-sub{font-size:9px;color:var(--text);font-family:var(--mono)}
    .img-panel img{display:block;width:100%;height:270px;object-fit:cover}
    .img-overlay{position:absolute;bottom:0;left:0;right:0;padding:8px 10px;background:linear-gradient(transparent,rgba(2,6,13,.9));display:flex;justify-content:space-between;align-items:flex-end}
    .img-coord{font-family:var(--mono);font-size:9px;color:var(--cyan);letter-spacing:.08em}
    .img-legend{display:flex;flex-direction:column;gap:3px;align-items:flex-end}
    .img-leg-row{display:flex;align-items:center;gap:5px;font-family:var(--mono);font-size:8px;color:var(--text-hi)}
    .img-leg-dot{width:6px;height:6px;border-radius:50%}

    .ndvi-panel{background:var(--panel);border:1px solid var(--border);border-radius:4px;padding:10px;display:flex;flex-direction:column;gap:10px}
    .ndvi-panel-title{font-family:var(--mono);font-size:9px;color:var(--text);letter-spacing:.12em;text-transform:uppercase}
    .ndvi-item{display:flex;flex-direction:column;gap:4px}
    .ndvi-item-top{display:flex;justify-content:space-between}
    .ndvi-item-zone{font-size:10px;color:var(--text-hi);font-weight:500}
    .ndvi-item-status{font-size:9px;color:var(--text);font-family:var(--mono)}
    .ndvi-item-val{font-family:var(--mono);font-size:11px;color:var(--cyan);font-weight:600}
    .ndvi-track{height:4px;background:var(--void);border-radius:2px;overflow:hidden}
    .ndvi-fill{height:100%;border-radius:2px;transition:width 1s ease;position:relative}
    .ndvi-fill::after{content:'';position:absolute;right:0;top:0;bottom:0;width:3px;background:white;opacity:.6}

    .right-col{display:flex;flex-direction:column;gap:8px}
    .panel{background:var(--panel);border:1px solid var(--border);border-radius:4px;overflow:hidden}
    .panel-hdr{padding:6px 10px;border-bottom:1px solid var(--border);font-family:var(--mono);font-size:9px;color:var(--text);letter-spacing:.12em;text-transform:uppercase;display:flex;align-items:center;gap:6px;background:rgba(0,0,0,.2)}
    .panel-hdr .ti{font-size:12px}
    .panel-body{padding:8px;display:flex;flex-direction:column;gap:5px}

    .alerta{padding:6px 8px;border-radius:3px;border-left:2px solid var(--border);background:rgba(0,0,0,.2)}
    .alerta.ok{border-left-color:var(--green)}
    .alerta.warn{border-left-color:var(--amber)}
    .alerta.critical{border-left-color:var(--red)}
    .alerta-title{font-size:10px;font-weight:600;color:var(--white);margin-bottom:2px}
    .alerta-desc{font-size:9px;color:var(--text);line-height:1.4}

    .mision{display:flex;gap:7px;padding:5px 0;border-bottom:1px solid var(--border)}
    .mision:last-child{border-bottom:none}
    .mision-prioridad{font-family:var(--mono);font-size:8px;font-weight:700;padding:2px 5px;border-radius:2px;white-space:nowrap;flex-shrink:0;margin-top:1px}
    .p-alta{background:var(--red-dim);color:var(--red);border:1px solid rgba(255,61,61,.2)}
    .p-media{background:var(--amber-dim);color:var(--amber);border:1px solid rgba(255,179,0,.2)}
    .p-baja{background:var(--green-dim);color:var(--green);border:1px solid rgba(0,229,160,.2)}
    .mision-zona{font-size:10px;font-weight:600;color:var(--text-hi)}
    .mision-tarea{font-size:9px;color:var(--text);line-height:1.4;margin-top:1px}

    .diag-panel{background:var(--panel);border:1px solid var(--border);border-radius:4px;overflow:hidden}
    .diag-hdr{padding:6px 12px;border-bottom:1px solid var(--border);font-family:var(--mono);font-size:9px;color:var(--cyan);letter-spacing:.14em;text-transform:uppercase;display:flex;align-items:center;gap:8px;background:rgba(0,212,255,.04)}
    .diag-body{padding:12px 14px;font-size:11px;color:var(--text-hi);line-height:1.8;font-style:italic}

    footer{background:var(--deep);border-top:1px solid var(--border);padding:.4rem 1.5rem;display:flex;justify-content:space-between;font-family:var(--mono);font-size:9px;color:var(--text);letter-spacing:.06em;flex-shrink:0}

    @media(max-width:1100px){.metrics-row{grid-template-columns:repeat(3,1fr)}.center-grid{grid-template-columns:1fr 1fr}}
    @media(max-width:768px){.upload-bar{grid-template-columns:1fr}.metrics-row{grid-template-columns:repeat(2,1fr)}.center-grid{grid-template-columns:1fr}}
  </style>
</head>
<body>

<header>
  <div class="hdr-left">
    <img src="logo2.png" alt="Vertech TdF" style="height:38px;width:auto;object-fit:contain;">
    <div class="hdr-brand">
      <span class="brand-name">VERTECH <span>TdF</span></span>
      <span class="brand-sub">Earth Observation Intelligence</span>
    </div>
  </div>
  <nav class="hdr-nav">
    <a href="agro.html" class="nav-link">AgroTech</a>
    <a href="mar.html"  class="nav-link active">Economía Azul</a>
    <a href="ch4.html"  class="nav-link">Metano CH₄</a>
  </nav>
  <div class="hdr-right">
    <div class="hdr-status"><span class="status-dot"></span> SAR ACTIVO</div>
    <img src="Bandera.png" alt="TdF" class="hdr-flag">
  </div>
</header>

<div class="main">

  <div class="upload-bar">
    <div class="field">
      <label class="field-lbl">Zona Marítima / Cuerpo de Agua</label>
      <input type="text" id="lugar" class="field-input" placeholder="Ej: Canal Beagle, Mar del Norte...">
    </div>
    <div class="field">
      <label class="field-lbl">Sensor / Fuente</label>
      <input type="text" id="fuente" class="field-input" placeholder="Ej: Sentinel-1 SAR, MODIS...">
    </div>
    <div class="field">
      <label class="field-lbl">Imagen Satelital / SAR</label>
      <div class="upload-btn" id="drop-zone">
        <input type="file" id="file-input" accept="image/*">
        <i class="ti ti-cloud-upload"></i> CARGAR IMAGEN
      </div>
    </div>
    <div class="field">
      <label class="field-lbl">&nbsp;</label>
      <button class="run-btn" id="btn-run" disabled><i class="ti ti-cpu"></i> PROCESAR</button>
    </div>
  </div>

  <div class="preview-strip" id="preview-strip">
    <img id="prev-thumb" src="" alt="">
    <span class="preview-fname" id="prev-name">—</span>
    <button class="btn-swap" id="btn-swap">↺ REEMPLAZAR</button>
  </div>

  <div class="proc-bar" id="proc-bar">
    <div class="proc-spin"></div>
    <span id="proc-txt">Procesando señal SAR...</span>
  </div>

  <div class="section-eyebrow">MÓDULO MARÍTIMO — VIGILANCIA · PESCA ILEGAL · MAREAS · OCEANOGRAFÍA</div>

  <div class="metrics-row">
    <div class="met accent-blue"><div class="met-lbl">Embarcaciones totales</div><div class="met-val blue" id="m0">—</div><div class="met-sub" id="ms0">Detectadas en imagen</div></div>
    <div class="met accent-red"><div class="met-lbl">Pesca ilegal sospechosa</div><div class="met-val red" id="m1">—</div><div class="met-sub" id="ms1">Sin AIS / zona restringida</div></div>
    <div class="met"><div class="met-lbl">Estado de mareas</div><div class="met-val" id="m2">—</div><div class="met-sub" id="ms2">Estimación costera</div></div>
    <div class="met"><div class="met-lbl">Temperatura sup. mar</div><div class="met-val white" id="m3">—</div><div class="met-sub" id="ms3">SST estimada</div></div>
    <div class="met accent-blue"><div class="met-lbl">Productividad marina</div><div class="met-val green" id="m4">—</div><div class="met-sub" id="ms4">Biomasa fitoplanctónica</div></div>
    <div class="met accent-amber"><div class="met-lbl">Nivel de alerta</div><div class="met-val amber" id="m5">—</div><div class="met-sub" id="ms5">Estado de vigilancia</div></div>
  </div>

  <div class="center-grid">
    <div class="img-panel">
      <div class="img-panel-hdr">
        <span class="img-panel-title" id="img-title">IMAGEN SAR — ECONOMÍA AZUL</span>
        <span class="img-panel-sub" id="img-sub">Aguardando carga</span>
      </div>
      <img id="sat-img" src="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='600' height='270'><rect width='600' height='270' fill='%230a1828'/><text x='50%' y='50%' fill='%230d2440' font-size='14' font-family='monospace' text-anchor='middle' dominant-baseline='middle'>[ AWAITING SAR INPUT ]</text></svg>" alt="">
      <div class="img-overlay">
        <span class="img-coord" id="img-coord">ZONA: —</span>
        <div class="img-legend">
          <div class="img-leg-row"><div class="img-leg-dot" style="background:#2196f3"></div>Buque Comercial</div>
          <div class="img-leg-row"><div class="img-leg-dot" style="background:#00e5a0"></div>Pesquero Validado</div>
          <div class="img-leg-row"><div class="img-leg-dot" style="background:#ff3d3d"></div>Traza Sospechosa</div>
        </div>
      </div>
    </div>

    <div class="ndvi-panel">
      <div class="ndvi-panel-title">Actividad por sector</div>
      <div id="ndvi-rows">
        <div style="color:var(--text);font-family:var(--mono);font-size:9px;padding:20px 0;text-align:center">[ ESPERANDO ANÁLISIS ]</div>
      </div>
    </div>

    <div class="right-col">
      <div class="panel">
        <div class="panel-hdr"><i class="ti ti-alert-triangle"></i> ALERTAS MARÍTIMAS</div>
        <div class="panel-body" id="alertas-body">
          <div style="color:var(--text);font-family:var(--mono);font-size:9px;padding:8px 0">[ ESPERANDO ANÁLISIS ]</div>
        </div>
      </div>
      <div class="panel">
        <div class="panel-hdr"><i class="ti ti-ship"></i> MISIONES DE VIGILANCIA</div>
        <div class="panel-body" id="misiones-body">
          <div style="color:var(--text);font-family:var(--mono);font-size:9px;padding:8px 0">[ ESPERANDO ANÁLISIS ]</div>
        </div>
      </div>
    </div>
  </div>

  <div class="diag-panel">
    <div class="diag-hdr"><i class="ti ti-file-description"></i> DIAGNÓSTICO OCEANOGRÁFICO Y DE VIGILANCIA MARÍTIMA</div>
    <div class="diag-body" id="diag-body">Cargá una imagen SAR o satelital marina y ejecutá el procesamiento para obtener el diagnóstico de vigilancia generado por Claude Vision.</div>
  </div>

</div>

<footer>
  <span>VERTECH TdF · RÍO GRANDE, TIERRA DEL FUEGO, ARGENTINA</span>
  <span>INNOVATÓN SPACE 2025 · SENTINEL-1 SAR · CLAUDE VISION · v3.1</span>
</footer>

<script>
  const BACKEND = 'https://vertech-backend.onrender.com';
  let b64 = null, mtype = 'image/jpeg';

  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');
  const strip = document.getElementById('preview-strip');
  const thumb = document.getElementById('prev-thumb');
  const fname = document.getElementById('prev-name');
  const btnSwap = document.getElementById('btn-swap');
  const btnRun = document.getElementById('btn-run');
  const procBar = document.getElementById('proc-bar');
  const procTxt = document.getElementById('proc-txt');

  dropZone.addEventListener('click', e => { if(e.target !== fileInput) fileInput.click(); });
  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.style.borderColor = 'var(--cyan)'; });
  dropZone.addEventListener('dragleave', () => { dropZone.style.borderColor = ''; });
  dropZone.addEventListener('drop', e => { e.preventDefault(); dropZone.style.borderColor = ''; if(e.dataTransfer.files[0]) load(e.dataTransfer.files[0]); });
  fileInput.addEventListener('change', e => { if(e.target.files[0]) load(e.target.files[0]); });
  btnSwap.addEventListener('click', () => { fileInput.value = ''; fileInput.click(); });

  function load(file) {
    if(!file.type.startsWith('image/')) { alert('Seleccioná una imagen.'); return; }
    const r = new FileReader();
    r.onload = e => {
      b64 = e.target.result.split(',')[1];
      mtype = file.type || 'image/jpeg';
      thumb.src = e.target.result;
      fname.textContent = file.name;
      strip.classList.add('visible');
      btnRun.disabled = false;
    };
    r.readAsDataURL(file);
  }

  const PASOS = [
    'Procesando señal de Radar de Apertura Sintética...',
    'Detectando trazas de embarcaciones en imagen...',
    'Analizando estado de mareas y corrientes...',
    'Identificando actividad pesquera sospechosa...',
    'Generando diagnóstico oceanográfico con Claude Vision...'
  ];

  btnRun.addEventListener('click', async () => {
    if(!b64) return;
    btnRun.disabled = true;
    procBar.classList.add('visible');
    let p = 0;
    const iv = setInterval(() => { if(p < PASOS.length) procTxt.textContent = PASOS[p++]; }, 950);

    try {
      const lugar  = document.getElementById('lugar').value.trim();
      const fuente = document.getElementById('fuente').value.trim() || 'Sentinel-1 SAR';

      const res = await fetch(`${BACKEND}/analizar-imagen`, {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ imagen_base64: b64, media_type: mtype, tipo: 'mar', lugar, fuente })
      });

      clearInterval(iv);
      procBar.classList.remove('visible');
      if(!res.ok) throw new Error((await res.json().catch(()=>({}))).detail || `HTTP ${res.status}`);
      render(await res.json(), lugar, fuente);

    } catch(e) {
      clearInterval(iv);
      procBar.classList.remove('visible');
      console.error(e);
      alert(`Error: ${e.message}`);
    }
    btnRun.disabled = false;
  });

  function render(d, lugar, fuente) {
    document.getElementById('sat-img').src = thumb.src;
    document.getElementById('img-title').textContent = (d.zona || lugar || 'Zona marítima').toUpperCase();
    document.getElementById('img-sub').textContent = fuente + ' · ' + new Date().toLocaleDateString('es-AR');
    document.getElementById('img-coord').textContent = 'ZONA: ' + (d.zona || lugar || '—');

    const colorMap = {green:'green',blue:'blue',red:'red',amber:'amber',neutral:'white',cyan:''};
    const ids = ['m0','m1','m2','m3','m4','m5'];
    (d.metricas||[]).forEach((m,i) => {
      const el = document.getElementById(ids[i]);
      const sub = document.getElementById('ms'+i);
      if(el){ el.textContent = m.value; el.className = 'met-val ' + (colorMap[m.color]||''); }
      if(sub) sub.textContent = m.sub;
    });

    document.getElementById('ndvi-rows').innerHTML = (d.zonas_ndvi||[]).map(z => `
      <div class="ndvi-item">
        <div class="ndvi-item-top">
          <div><div class="ndvi-item-zone">${z.zona}</div><div class="ndvi-item-status">${z.estado}</div></div>
          <span class="ndvi-item-val">${z.ndvi}</span>
        </div>
        <div class="ndvi-track"><div class="ndvi-fill" style="width:${z.pct||50}%;background:linear-gradient(90deg,#2196f388,#2196f3)"></div></div>
      </div>`).join('');

    const icons = {ok:'ti-circle-check',warn:'ti-alert-triangle',critical:'ti-alert-octagon'};
    document.getElementById('alertas-body').innerHTML = (d.alertas||[]).map(a => `
      <div class="alerta ${a.tipo||'warn'}">
        <div class="alerta-title"><i class="ti ${icons[a.tipo]||'ti-alert-triangle'}"></i> ${a.titulo}</div>
        <div class="alerta-desc">${a.desc}</div>
      </div>`).join('');

    document.getElementById('misiones-body').innerHTML = (d.misiones||[]).map(m => `
      <div class="mision">
        <span class="mision-prioridad p-${(m.prioridad||'MEDIA').toLowerCase()}">${m.prioridad}</span>
        <div>
          <div class="mision-zona">${m.zona}</div>
          <div class="mision-tarea">${m.tarea}</div>
        </div>
      </div>`).join('');

    document.getElementById('diag-body').textContent = d.diagnostico || '—';
  }
</script>
</body>
</html>
